# Neon PostgreSQL Connection Strings
# 1. DATABASE_URL: Pooled connection string (PgBouncer) for serverless queries on Vercel
# Example: postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/monolith_db?schema=public"

# 2. DIRECT_URL: Direct unpooled connection string (Port 5432) for Prisma migrations
# Example: postgresql://[user]:[password]@[endpoint].[region].aws.neon.tech/[dbname]?sslmode=require
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/monolith_db?schema=public"

# NextAuth Configuration
NEXTAUTH_SECRET="monolith-ultra-secure-secret-key-replace-in-production"
NEXTAUTH_URL="http://localhost:3000"
